# Copy to .env for local runs. Everything here is optional: the app starts without any of it.
# Never commit .env.

# Free Gemini key from https://aistudio.google.com/apikey (users can also add their own in the app)
AI_API_KEY=

# PostgreSQL with pgvector, pasted as the provider shows it. Empty = built-in in-memory database.
DATABASE_URL=

# Google sign-in. Empty = username/password and guest only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts keys users save in the app. Empty = new key each start (saved keys lost on restart).
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Upload limits (defaults shown)
DOCUMENTS_MAX_BYTES=5242880
DOCUMENTS_MAX_PAGES=50
DOCUMENTS_MAX_PER_USER=20
