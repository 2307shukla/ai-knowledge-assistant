# Copy to deploy/.env and fill in. deploy/.env is git-ignored; never commit real values.

# Your domain, or <ip-with-dashes>.sslip.io (free, no domain needed). Example: 203-0-113-10.sslip.io
SITE_ADDRESS=replace-me.example.com

# Use letters and digits only (for example: openssl rand -hex 24), so the database URL stays valid.
POSTGRES_PASSWORD=replace-with-random-hex

# Encrypts users' saved personal API keys. Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-with-random-base64

# Optional shared free Gemini key. Leave empty to let each user paste their own in Settings.
AI_API_KEY=

# Relevance cutoff for document answers (tuned for Gemini embeddings).
APP_RAG_MIN_SCORE=0.55
